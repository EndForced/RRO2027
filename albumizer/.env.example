# Токен от @BotFather
BOT_TOKEN=

# Необязательно: только эти Telegram user id смогут пользоваться ботом
ALLOWED_USERS=

# AI (необязательно). Порядок = порядок failover. Без ключей бот работает на эвристиках.
#   groq       — бесплатно, ключ: https://console.groq.com/keys
#   gemini     — бесплатный тариф, ключ: https://aistudio.google.com/apikey
#   openrouter — бесплатные модели с суффиксом :free, ключ: https://openrouter.ai/keys
#   cerebras, ollama (локально, ключ не нужен)
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Проверять найденное «полное видео» через LLM (отсекает каверы/live)
LLM_JUDGE=1

# Порядок площадок
SOURCES=youtube_full,ytmusic_album,bandcamp,archive_org,youtube_tracks,soundcloud_tracks

WORKDIR=./data
MAX_PARALLEL_JOBS=2
DOWNLOAD_CONCURRENCY=3
AUDIO_QUALITY=192
# Если YouTube требует «подтвердите, что вы не бот» — cookies.txt из браузера
YTDLP_COOKIES=
YTDLP_PROXY=
MUSICBRAINZ_USER_AGENT=Albumizer/0.1 (you@example.com)
